{
  "releases": $sort(
    $.{
      "changelogUrl": "https://docs.konghq.com/gateway/changelog" & "#" & $replace($replace(version, /-1/, ""), /\./, "-"),
      "digest": checksum_sha256,
      "isDeprecated": $not("latest" in tags.version),
      "isStable": true,
      "isLTS": $join($split(version, ".", 2), ".") in ["3.4", "3.10", "3.14", "3.18", "3.22"],
      "newDigest": checksum_sha256,
      "releaseTimestamp": uploaded_at,
      "sourceUrl": cdn_url,
      "version": $replace(version, "-1", "")
    },
    function($l, $r) {
      $l.version < $r.version
    }
  ),
  "homepage": "https://konghq.com/products/kong-enterprise"
}
