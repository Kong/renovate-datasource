{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  // "extends": ["config:best-practices"],
  "dependencyDashboard": true,
  logLevelRemap: [
    //
    // DIY errors
    //
    // {
    //   matchMessage: '/^lookupUpdates error/',
    //   newLogLevel: 'debug',
    // },
    {
      matchMessage: '/^lookupUpdates error/',
      newLogLevel: 'error',
    },
    {
      matchMessage: '/^Dependency .+ has unsupported/unversioned value/',
      newLogLevel: 'warn',
    },
    {
      matchMessage: '/^lookupUpdates/',
      newLogLevel: 'debug',
    },
    // "Value is not updated" or "Digest is not updated" indicates that the
    // custom manager did a replacement, but can't find the new digest/value in
    // the file afterwards
    {
      matchMessage: '/ is not updated /',
      newLogLevel: 'error',
    },
    {
      matchMessage: '/^Config validation errors found/',
      newLogLevel: 'error',
    },

    // custom manager output (normally trace)
    {
      matchMessage: '/HTTP request/',
      newLogLevel: 'debug',
    },
    {
      matchMessage: '/Skipping bump because newValue is the same/',
      newLogLevel: 'debug',
    },
    {
      matchMessage: '/^Found no satisfying versions with/',
      newLogLevel: 'warn',
    },
    {
      matchMessage: '/^Custom manager fetcher/',
      newLogLevel: 'debug',
    },
    {
      matchMessage: '/^Error while evaluating JSONata expression/',
      newLogLevel: 'debug',
    },
    {
      matchMessage: '/^Response that has failed validation/',
      newLogLevel: 'debug',
    },
    {
      matchMessage: '/custom datasource/',
      newLogLevel: 'debug',
    },
    {
      matchMessage: '/^Error while evaluating/',
      newLogLevel: 'debug',
    },
    // {
    //   matchMessage: '/^Response has failed validation/',
    //   newLogLevel: 'debug',
    // },
    {
      matchMessage: '/^Response that has failed validation/',
      newLogLevel: 'debug',
    },

    // PR creation
    {
      matchMessage: '/^prTitle: /',
      newLogLevel: 'debug',
    },

    // shhhhhh
    {
      matchMessage: '/^Branch lists/',
      newLogLevel: 'trace',
    },
    {
      matchMessage: '/^branch\\.isModified\\(\\) = true/',
      newLogLevel: 'trace',
    },
  ],
  // "baseBranches": [
  //   "feat/pkgs"
  // ],
  // "useBaseBranchConfig": "merge",
  "enabledManagers": [
    "custom.regex"
    // ,"dockerfile"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [
        "kong/kong-ee/hardening_manifest.yaml"
      ],
      "matchStrings": [
        // tags:
        // - 3.7.1.1
        // - latest
        // <snip>
        //   org.opencontainers.image.version: 3.7.1.1
        "(?<depName>tags):\\s- (?<currentValue>[0-9\\.]{7})",
        "(?<depName>image\\.version): (?<currentValue>[0-9\\.]{7})",
      ],
      "depNameTemplate": "kong-ee/{{{depName}}}",
      "packageNameTemplate": "kong/kong-ee",
      "datasourceTemplate": "custom.pages",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)$",
    },
    {
      "customType": "regex",
      "fileMatch": [
        "kong/kong-ee/hardening_manifest.yaml"
      ],
      "matchStrings": [
        // - url: https://packages.konghq.com/public/gateway-37/rpm/el/9/x86_64/kong-enterprise-edition-fips-3.7.1.1.el9.x86_64.rpm
        //   filename: kong-enterprise-edition.noarch.rpm
        //   validation:
        //     type: sha256
        //     value: f4115a6f6e106d456ccfff9f3dfe941218ff71cec21c5581d5154440b10827cd
        "url: https://packages.konghq.com/public/gateway-\\d\\d/rpm/el/(?<el>\\d+)/x86_64/kong-enterprise-edition-fips-(?<currentValue>[0-9\\.]{7}).el\\d+.x86_64.rpm\n  filename: (?<filename>.+)\n  validation:\n    type: sha256\n    value: (?<currentDigest>[a-f0-9]{64})",
      ],
      "depNameTemplate": "kong-ee/el/{{el}}",
      "packageNameTemplate": "kong/kong-ee",
      "datasourceTemplate": "custom.pages",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)$",
      "autoReplaceStringTemplate": "url: https://packages.konghq.com/public/gateway-{{{newMajor}}}{{{newMinor}}}/rpm/el/{{{el}}}/x86_64/kong-enterprise-edition-fips-{{{newValue}}}.el{{{el}}}.x86_64.rpm\n  filename: {{{filename}}}\n  validation:\n    type: sha256\n    value: {{{newDigest}}}",
    },
    {
      "customType": "regex",
      "fileMatch": [
        "kong/kong/hardening_manifest.yaml"
      ],
      "matchStrings": [
        // - url: https://packages.konghq.com/public/gateway-34/rpm/el/9/x86_64/kong-3.4.2.el9.x86_64.rpm
        //   filename: kong.rpm
        //   validation:
        //     type: sha256
        //     value: 74dacae7e82ed2de8bad5882e085a68a4cfda3d12bb88980e0cdc98585de7dd6
        "url: https://packages.konghq.com/public/gateway-\\d\\d/rpm/el/(?<el>\\d+)/x86_64/kong-(?<currentValue>[0-9\\.]{5}).el\\d+.x86_64.rpm\n  filename: (?<filename>.+)\n  validation:\n    type: sha256\n    value: (?<currentDigest>[a-f0-9]{64})",
      ],
      "depNameTemplate": "kong/el/{{el}}",
      "packageNameTemplate": "kong/kong",
      "datasourceTemplate": "custom.pages",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
      "autoReplaceStringTemplate": "url: https://packages.konghq.com/public/gateway-{{{newMajor}}}{{{newMinor}}}/rpm/el/{{{el}}}/x86_64/kong-{{{newValue}}}.el{{{el}}}.x86_64.rpm\n  filename: {{{filename}}}\n  validation:\n    type: sha256\n    value: {{{newDigest}}}",
    },
    {
      "customType": "regex",
      "fileMatch": [
        "hardening_manifest.yaml"
      ],
      "matchStrings": [
        "- url: https://github.com/kong/deck/releases/download/v(?<currentValue>[0-9\\.]{5,})/deck_(?:[0-9\\.]{5,})_linux_amd64.tar.gz\n  filename: deck.tar.gz\n  validation:\n    type: sha256\n    value: (?<currentDigest>[a-f0-9]{64})"
      ],
      "datasourceTemplate": "custom.pages",
      "packageNameTemplate": "kong/deck"
    },
  ],
  "customDatasources": {
    "pages": {
      "defaultRegistryUrlTemplate": "https://kong.github.io/renovate-datasource/{{packageName}}/releases.json",
      "format": "json",
    }
  },
  "packageRules": [
    {
      "matchDepNames": [
        "/^kong-ee\\//"
      ],
      "groupName": "Kong Enterprise"
    },
    {
      "matchDepNames": [
        "/^kong\\//"
      ],
      "groupName": "Kong Enterprise"
    },
  ]
  // ,"hostRules": [
  //   {
  //     "hostType": "docker",
  //     "matchHost": "{{ secrets.REGISTRY1_ENDPOINT }}",
  //     "username": "{{ secrets.REGISTRY1_USERNAME }}",
  //     "password": "{{ secrets.REGISTRY1_TOKEN }}"
  //   }
  // ]
}
